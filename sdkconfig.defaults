# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# Cyber badge, game library and wooden-fish page use internal RAM only.
CONFIG_LV_MEM_SIZE_KILOBYTES=32
# Release TLS I/O buffers between packets; keep full certificate verification
# and normal maximum TLS record lengths for existing HTTPS radio streams.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Outgoing MQTT/Opus frames fit 2 KiB; incoming TLS records retain 16 KiB.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# Match XiaoZhi's no-PSRAM C3 receive/IRAM budget. Keep the badge's existing
# network manager, WPA configuration and shared hotspot protocol.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# NVS saves may overlap short PCM playback; keep I2S interrupts in internal RAM.
CONFIG_I2S_ISR_IRAM_SAFE=y

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# XiaoZhi reversible standby; preserve USB configuration while attached.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_BUTTON_PERIOD_TIME_MS=50
CONFIG_BUTTON_DEBOUNCE_TICKS=1
CONFIG_BUTTON_LONG_PRESS_HOLD_SERIAL_TIME_MS=50
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# Buffer incoming speech bursts while I2S drains a PCM frame.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# Release firmware: optimize code size without removing assertions or features.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS is not set
